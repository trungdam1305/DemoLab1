# Copy file này thành .env (chạy local) rồi dán API key thật vào.
# Khi deploy lên Render, KHÔNG dùng file này — nhập biến môi trường
# trực tiếp trong dashboard Render (Environment tab).

# ===== Cách 1: OpenAI (mặc định) =====
OPENAI_API_KEY=sk-your-key-here

# ===== Cách 2: NVIDIA NIM — MIỄN PHÍ =====
# OPENAI_API_KEY=nvapi-your-key-here
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# LAB_MODEL=meta/llama-3.3-70b-instruct
# LAB_MINI_MODEL=meta/llama-3.1-8b-instruct
